// Branco total + barra (Mustiskooo) — fonte: discussao fastfetch #971 (barra-total).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " ",
        "color": {
            "keys": "white",
            "title": "white",
            "output": "white",
            "separator": "white"
        },
        "percent": {
            "type": [
                "bar"
            ]
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "├─ OS",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "├─ Kernel",
            "keyColor": "light_magenta"
        },
        {
            "type": "uptime",
            "key": "├─ Uptime",
            "keyColor": "white"
        },
        {
            "type": "packages",
            "key": "├─ Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "├─ Shell",
            "keyColor": "magenta"
        },
        {
            "type": "de",
            "key": "├─ DE",
            "keyColor": "light_magenta"
        },
        {
            "type": "wm",
            "key": "├─ WM",
            "keyColor": "white"
        },
        "break",
        {
            "type": "cpu",
            "key": "├─ CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "├─ GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "├─ Memory",
            "keyColor": "light_magenta",
            "format": "{used} / {total} {percentage-bar}"
        },
        {
            "type": "disk",
            "key": "├─ Disk",
            "keyColor": "white"
        },
        {
            "type": "battery",
            "key": "╰─ Battery",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "custom",
            "format": "{#green}███{#}{#yellow}███{#}{#blue}███{#}{#magenta}███{#}{#blue}███{#}{#yellow}███{#}{#green}███{#}"
        },
        {
            "type": "custom",
            "format": "{#green}███{#}{#yellow}███{#}{#blue}███{#}{#magenta}███{#}{#blue}███{#}{#yellow}███{#}{#green}███{#}"
        }
    ]
}
