// Minimo demure (meetthehorizon) — fonte: discussao fastfetch #971 (demure-minimo).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "left": 2,
            "top": 2
        }
    },
    "display": {
        "key": {
            "width": 14
        },
        "separator": "  "
    },
    "modules": [
        {
            "type": "title"
        },
        "break",
        {
            "format": "{pretty-name}",
            "key": "  OS",
            "keyColor": "green",
            "type": "os"
        },
        {
            "key": " 󰌽 Kernel",
            "keyColor": "yellow",
            "type": "kernel"
        },
        {
            "format": "{pretty-name}",
            "key": "  WM",
            "keyColor": "blue",
            "type": "wm"
        },
        {
            "format": "{pretty-name}",
            "key": "  Shell",
            "keyColor": "magenta",
            "type": "shell"
        },
        {
            "key": " 󰔚 Uptime",
            "keyColor": "cyan",
            "type": "uptime"
        },
        {
            "format": "{used} / {total}",
            "key": "  Ram",
            "keyColor": "green",
            "type": "memory"
        },
        {
            "format": "{pretty-name}",
            "key": " 󰸱 Color",
            "symbol": "circle",
            "type": "colors"
        }
    ]
}
