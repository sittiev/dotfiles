// Taiyo anime (Zoltraak57) — fonte: discussao fastfetch #971 (taiyo).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "left": 1
        }
    },
    "display": {
        "key": {
            "width": 10
        },
        "separator": ""
    },
    "modules": [
        "break",
        {
            "type": "title",
            "keyColor": "green"
        },
        {
            "type": "separator",
            "keyColor": "yellow"
        },
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "green",
            "format": "{name} {version-id}"
        },
        {
            "type": "kernel",
            "key": "󰌽 KER",
            "keyColor": "yellow",
            "format": "{release} {machine}"
        },
        {
            "type": "host",
            "key": "󰍹 HOST",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰥔 UP",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗 PKG",
            "keyColor": "cyan",
            "format": "{all}"
        },
        {
            "type": "shell",
            "key": "󰞷 SH",
            "keyColor": "red",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "󰆍 TERM",
            "keyColor": "green",
            "format": "{pretty-name}"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "yellow",
            "format": "{name} ({cores})"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "blue",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "swap",
            "key": "󰓡 SWP",
            "keyColor": "magenta",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": "󰋊 SSD",
            "keyColor": "green",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "battery",
            "key": "󰁹 BAT",
            "keyColor": "yellow",
            "format": "{capacity}%"
        },
        {
            "type": "locale",
            "key": "󰆌 LANG",
            "keyColor": "blue"
        },
        {
            "type": "break"
        }
    ]
}
