// Chaves por grupo (Jojac5) — fonte: discussao fastfetch #971 (grupos-cor).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 2,
            "left": 4
        }
    },
    "display": {
        "key": {
            "width": 15
        },
        "separator": "~>"
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{6} | {8}"
        },
        "separator",
        {
            "type": "os",
            "key": "OS       ",
            "keyColor": "green",
            "format": "{4}{?6} ({#yellow}{6}{#}){?} v{9}"
        },
        {
            "type": "kernel",
            "key": "Kernel   ",
            "keyColor": "green",
            "format": "{1} {2}"
        },
        {
            "type": "users",
            "key": "User     ",
            "keyColor": "green",
            "format": "{1} - {5}"
        },
        "break",
        {
            "type": "uptime",
            "key": "Uptime   ",
            "keyColor": "yellow"
        },
        {
            "type": "board",
            "key": "Board    ",
            "keyColor": "yellow",
            "format": "{1}"
        },
        {
            "type": "bios",
            "key": "Bios     ",
            "keyColor": "yellow",
            "format": "{4} - {1}"
        },
        {
            "type": "cpu",
            "key": "CPU      ",
            "temp": true,
            "showPeCoreCount": true,
            "keyColor": "yellow",
            "format": "{1} ({4}) {8}"
        },
        {
            "type": "gpu",
            "key": "GPU      ",
            "temp": true,
            "showPeCoreCount": true,
            "keyColor": "yellow",
            "format": "{1} {2} {4}"
        },
        {
            "type": "memory",
            "key": "RAM      ",
            "temp": true,
            "showPeCoreCount": true,
            "keyColor": "yellow",
            "format": "{1} / {2} {3}"
        },
        "break",
        {
            "type": "Disk",
            "key": "Disk     ",
            "keyColor": "blue",
            "format": "{1} / {2} {3} "
        },
        "break",
        {
            "type": "sound",
            "key": "Sound    ",
            "keyColor": "magenta",
            "format": "{2} {3}"
        },
        {
            "type": "media",
            "key": "Media    ",
            "keyColor": "magenta",
            "format": "{5}: {#underline_yellow}{1}{#} {?3}by {#1}{3}{#}{?}"
        },
        {
            "type": "dateTime",
            "key": "Date     ",
            "keyColor": "magenta",
            "format": "{23}-{4}-{1} | {14}:{18}:{20}"
        }
    ]
}
