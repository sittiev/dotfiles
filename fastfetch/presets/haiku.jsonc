// Caixas por secao (rcbellN51 Haiku) — fonte: discussao fastfetch #971 (haiku).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 5,
            "right": 2,
            "bottom": 0,
            "left": 2
        }
    },
    "display": {
        "brightColor": "true",
        "separator": "",
        "constants": [
            "\u001b[77C",
            "\u001b[77D",
            "\u001b[88C",
            "\u001b[20D",
            "───────────────────────────────────────────────────────────────────────────────────────"
        ],
        "key": {
            "width": 14
        }
    },
    "general": {},
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "╭─{$5}─╮",
            "outputColor": "green"
        },
        {
            "type": "os",
            "key": "│        OS:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "host",
            "key": "│      Host:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "│    Kernel:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│    Uptime:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "│  Packages:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "│     Shell:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "│  Terminal:{$1} │",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "╰─{$5}─╯",
            "outputColor": "green"
        },
        {
            "type": "custom",
            "format": "╭─{$5}─╮",
            "outputColor": "yellow"
        },
        {
            "type": "de",
            "key": "│        DE:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "│        WM:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "wmtheme",
            "key": "│  WM Theme:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "theme",
            "key": "│     Theme:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "cursor",
            "key": "│    Cursor:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "icons",
            "key": "│     Icons:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "font",
            "key": "│      Font:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "terminalfont",
            "key": "│ Term Font:{$1} │",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "╰─{$5}─╯",
            "outputColor": "yellow"
        },
        {
            "type": "custom",
            "format": "╭─{$5}─╮",
            "outputColor": "blue"
        },
        {
            "type": "cpu",
            "key": "│       CPU:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "│       GPU:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "│     Video:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "sound",
            "key": "│     Sound:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "│    Memory:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "swap",
            "key": "│      Swap:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "│      Disk:{$1} │",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "╰─{$5}─╯",
            "outputColor": "blue"
        },
        {
            "type": "custom",
            "format": "╭─{$5}─╮",
            "outputColor": "magenta"
        },
        {
            "type": "title",
            "fqdn": true,
            "key": "│      User:{$1} │",
            "keyColor": "magenta",
            "color": {
                "user": "bright_white",
                "at": "bright_white",
                "host": "bright_white"
            }
        },
        {
            "type": "localip",
            "key": "│  Local IP:{$1} │",
            "keyColor": "magenta"
        },
        {
            "type": "locale",
            "key": "│    Locale:{$1} │",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "╰──{$5}{$4}┬─ {#black} {#red} {#green} {#yellow} {#blue} {#magenta} {#cyan} {#white}{#cyan} ─┤",
            "outputColor": "magenta"
        },
        {
            "type": "custom",
            "format": "  {$3}{$4}╰─ {#bright_black} {#bright_red} {#bright_green} {#bright_yellow} {#bright_blue} {#bright_magenta} {#bright_cyan} {#bright_white}{#reset_default}{#cyan} ─╯",
            "outputColor": "magenta"
        },
        "break"
    ]
}
