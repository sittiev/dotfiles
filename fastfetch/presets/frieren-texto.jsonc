// Frieren texto (Vaishnav) — fonte: discussao fastfetch #971 (frieren-texto).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "left": 1
        }
    },
    "display": {
        "key": {
            "width": 10
        },
        "separator": ""
    },
    "modules": [
        "break",
        {
            "type": "command",
            "key": "󰀄 USER",
            "keyColor": "green",
            "text": "echo $USER@$(hostnamectl hostname)"
        },
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "yellow",
            "format": "{name} {version-id}"
        },
        {
            "type": "command",
            "key": "󰌽 KER",
            "keyColor": "blue",
            "text": "echo $(uname -r | cut -d- -f1) $(uname -m)"
        },
        {
            "type": "packages",
            "key": "󰏗 PKG",
            "keyColor": "magenta",
            "format": "{all}"
        },
        {
            "type": "terminal",
            "key": "󰆍 TERM",
            "keyColor": "cyan",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "󰞷 SH",
            "keyColor": "red",
            "format": "{pretty-name}"
        },
        {
            "type": "uptime",
            "keyColor": "green",
            "key": "󰥔 UP"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "yellow",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "󰋊 SSD",
            "keyColor": "blue",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "custom",
            "format": "\u001b[90m \u001b[91m \u001b[92m \u001b[93m \u001b[94m \u001b[95m \u001b[96m \u001b[97m"
        },
        "break"
    ]
}
