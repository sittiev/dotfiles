// Logo texto laranja (jaimeadeur) — fonte: discussao fastfetch #971 (logo-laranja).
// Cores do schema (paleta do terminal); nenhum hex/RGB fixo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": "╭ ",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "├ ",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "├󰏖 ",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "╰ ",
            "keyColor": "green",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference días"
        },
        "break",
        {
            "type": "terminal",
            "key": "╭ ",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "├ ",
            "keyColor": "green"
        },
        {
            "type": "terminalfont",
            "key": "╰ ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "host",
            "key": "╭ ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├ ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "├ ",
            "format": "{2}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├ ",
            "keyColor": "green",
            "percent": {
                "type": 3
            }
        },
        {
            "type": "disk",
            "key": "├ ",
            "keyColor": "green",
            "percent": {
                "type": 3
            }
        },
        {
            "type": "uptime",
            "key": "╰󰅐 ",
            "keyColor": "green"
        },
        "break",
        {
            "type": "sound",
            "key": "╭ ",
            "format": "{2}",
            "keyColor": "green"
        },
        {
            "type": "media",
            "key": "╰ ",
            "keyColor": "green"
        },
        "break"
    ]
}
