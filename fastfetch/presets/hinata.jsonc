            "keyColor": "white"
        },
        {
            "type": "disk",
            "outputColor": "white",
            "format": "",
            "key": " DISKS  ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "key": "",
            "keyColor": "white"
        },
        {
            "type": "localip",
            "outputColor": "white",
            "format": "{ifname} {ipv4}",
            "key": " IPADD 󰩟 ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "key": "",
