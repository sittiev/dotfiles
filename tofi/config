# dark-paper — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh (pywal low-contrast).
# outline-width/corner-radius sempre 0 (moldura preta sem alfa).
# tofi dark-paper — tela cheia tipográfica (baseado em themes/dark-paper upstream)
# Upstream usa font = Fanwood Text; aqui Noto Sans (fonte unica, rampa MS).
# Title 28 na rampa MS.
font-size = 28
hint-font = false
padding-left = 4%
padding-top = 2%
padding-right = 0
padding-bottom = 0
prompt-text = ""
width = 100%
height = 100%
anchor = center
exclusive-zone = -1
scale = true
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
drun-launch = true
terminal = foot
# tofi-colors-begin (gerado por tofi-apply.sh — nao editar este bloco)
# FONT por NOME de familia, nunca por caminho: com caminho absoluto o Pango nao
# monta a cadeia de fallback do fontconfig e todo emoji vira caixa vazia.
# Fonte unica Noto (rampa MS/Apple); tamanhos por layout (12/14/18/28).
font = Noto Sans
text-color = #3a3936
background-color = #e8e7e3
selection-color = #fafafa
selection-background = #898365
selection-match-color = #000000
placeholder-color = #3a3936A8
prompt-background = #00000000
input-background = #00000000
input-color = #3a3936
alternate-result-background = #00000000
default-result-background = #00000000
prompt-color = #3a3936
border-color = #898365
outline-width = 0
corner-radius = 0
border-width = 0
