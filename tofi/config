anchor = top
width = 100%
# 24px, e nao 18: o Pango usa a MAIOR caixa deMetrics da linha. O fallback
# (Liberation Sans, a menor das 281 fontes com cobertura portuguesa) tem
# 1.117em, que a 20px da 22.3px — mais que os 18px da barra, e cortava a
# metade de baixo das letras. Nenhuma fonte instalada tem caixa menor.
# NAO voltar a 18 sem antes trocar a fonte: sem fallback o texto acentuado
# some inteiro, que e pior que cortar.
height = 24
horizontal = true
font-size = 20
prompt-text = ""
# border/outline 0: os dois consomem area de conteudo (outline 4 tira 8px de
# cada lado). Com 24px sobra 1.7px, so caberia moldura de 0.
min-input-width = 120
result-spacing = 15
padding-top = 0
padding-bottom = 0
padding-left = 0
padding-right = 0
# tofi-colors-begin (gerado por tofi-apply.sh — nao editar este bloco)
# FONT por NOME de familia, nunca por caminho: com caminho absoluto o Pango nao
# monta a cadeia de fallback do fontconfig e todo emoji vira caixa vazia.
#
# A fallback e OBRIGATORIA: FindersKeepers tem so 130 codepoints (nenhum
# acentuado) e sem a lista o tofi DESAPARECE a linha inteira em vez de cair no
# fallback. Separador eh ESPACO: "A, B" e "A,B" nao funcionam no tofi.
#
# Liberation Sans = 1.117em, a menor caixa win entre as 281 fontes do sistema
# com cobertura completa. Isso importa: o Pango usa a MAIOR caixa da linha, e
# 1.117em a 20px = 22.3px, maior que a barra de 18px — por isso o texto
# acentuado corta em 20px e so fecha em 16px. Nenhuma fonte instalada resolve.
font = FindersKeepers Liberation Sans
text-color = #373839
background-color = #e3e5e8
selection-color = #f9f9fa
selection-background = #657489
selection-match-color = #f9f9f9
placeholder-color = #373839A8
prompt-background = #00000000
input-background = #00000000
input-color = #373839
alternate-result-background = #00000000
default-result-background = #00000000
prompt-color = #373839
border-color = #657489
outline-width = 0
corner-radius = 0
border-width = 0
