# emoji — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh.
# NAO mexer em font-size sem recalcular: o NotoColorEmoji tem caixa win de
# 1.171875em, muito maior que a do FindersKeepers (0.79em). O Pango usa a maior
# caixa da linha, entao num height=18 o limite e 18/1.171875 = 15.3px.
# 16px estoura (18.8px) e corta a parte de baixo do emoji e do rotulo.
font-size = 14
hint-font = false
horizontal = true
anchor = center
width = 700
height = 120
# border/outline 0 herdado do bloco canonico (tofi-apply.sh); padding espelhado
# do clipboard para a mesma caixa central.
border-width = 0
padding-top = 14
padding-bottom = 14
padding-left = 18
padding-right = 18
min-input-width = 120
result-spacing = 12
prompt-text = ""
scale = true
exclusive-zone = -1
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
auto-accept-single = false
