# clipboard — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh.
# Diferenca do dmenu: resultados em coluna e janela centralizada, porque o
# clipboard tem 50 entradas e nao cabe em uma barra de 28px.
# Renderizado em ~/.config/tofi/config-clipboard (mesma paleta do launcher).
font-size = 20
hint-font = false
horizontal = false
anchor = center
width = 700
height = 520
border-width = 0
padding-top = 14
padding-bottom = 14
padding-left = 18
padding-right = 18
prompt-text = ""
min-input-width = 0
result-spacing = 4
scale = true
exclusive-zone = -1
clip-to-padding = true
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
auto-accept-single = false
hide-input = false
