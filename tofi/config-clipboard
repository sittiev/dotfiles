# clipboard — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh.
# Diferenca do dmenu: resultados em coluna e janela centralizada, porque o
# clipboard tem 50 entradas e nao cabe em uma barra de 28px.
# Renderizado em ~/.config/tofi/config-clipboard (mesma paleta do launcher).
font-size = 18
hint-font = false
horizontal = false
anchor = center
width = 700
height = 520
padding-top = 14
padding-bottom = 14
padding-left = 18
padding-right = 18
prompt-text = ""
min-input-width = 0
result-spacing = 4
scale = true
exclusive-zone = -1
clip-to-padding = true
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
auto-accept-single = false
hide-input = false
# tofi-colors-begin (gerado por tofi-apply.sh — nao editar este bloco)
font = Noto Sans
text-color = #3a3936
background-color = #e8e7e3
selection-color = #fafafa
selection-background = #898365
selection-match-color = #000000
placeholder-color = #3a3936A8
prompt-background = #00000000
input-background = #00000000
input-color = #3a3936
alternate-result-background = #00000000
default-result-background = #00000000
prompt-color = #3a3936
border-color = #898365
outline-width = 0
corner-radius = 0
border-width = 0
