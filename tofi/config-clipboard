# clipboard — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh.
# Diferenca do dmenu: resultados em coluna e janela centralizada, porque o
# clipboard tem 50 entradas e nao cabe em uma barra de 28px.
# Renderizado em ~/.config/tofi/config-clipboard (mesma paleta do launcher).
font-size = 20
hint-font = false
horizontal = false
anchor = center
width = 700
height = 520
padding-top = 14
padding-bottom = 14
padding-left = 18
padding-right = 18
prompt-text = ""
min-input-width = 0
result-spacing = 4
scale = true
exclusive-zone = -1
clip-to-padding = true
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
auto-accept-single = false
hide-input = false
# tofi-colors-begin (gerado por tofi-apply.sh — nao editar este bloco)
# FONT por NOME de familia, nunca por caminho: com caminho absoluto o Pango nao
# monta a cadeia de fallback do fontconfig e todo emoji vira caixa vazia.
font = FindersKeepers
text-color = #ecedee
background-color = #0b0d0e
selection-color = #dbdbdc
selection-background = #595d5f
selection-match-color = #dadada
placeholder-color = #ecedeeA8
prompt-background = #00000000
input-background = #00000000
input-color = #ecedee
alternate-result-background = #00000000
default-result-background = #00000000
prompt-color = #ecedee
border-color = #595d5f
outline-width = 0
corner-radius = 0
border-width = 0
