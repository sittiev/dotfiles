# emoji — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh.
# Com a fonte unica Noto (caixa 1.362em) o texto domina a linha, nao o
# NotoColorEmoji (1.171875em): Body 14 rende 19.1px/linha na janela de 520px,
# sem corte. (O limite antigo de 15.3px era da caixa 0.79em do FindersKeepers.)
font-size = 14
hint-font = false
horizontal = false
anchor = center
width = 700
height = 520
# border/outline 0 herdado do bloco canonico (tofi-apply.sh); padding espelhado
# do clipboard para a mesma caixa central.
padding-top = 14
padding-bottom = 14
padding-left = 18
padding-right = 18
min-input-width = 120
result-spacing = 12
prompt-text = ""
scale = true
exclusive-zone = -1
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
auto-accept-single = false
# tofi-colors-begin (gerado por tofi-apply.sh — nao editar este bloco)
# FONT por NOME de familia, nunca por caminho: com caminho absoluto o Pango nao
# monta a cadeia de fallback do fontconfig e todo emoji vira caixa vazia.
# Fonte unica Noto (rampa MS/Apple); tamanhos por layout (12/14/18/28).
font = Noto Sans
text-color = #3a3936
background-color = #e8e7e3
selection-color = #fafafa
selection-background = #898365
selection-match-color = #000000
placeholder-color = #3a3936A8
prompt-background = #00000000
input-background = #00000000
input-color = #3a3936
alternate-result-background = #00000000
default-result-background = #00000000
prompt-color = #3a3936
border-color = #898365
outline-width = 0
corner-radius = 0
border-width = 0
