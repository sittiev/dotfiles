# emoji — layout-only (geometria/fontes/comportamento). Cores via tofi-apply.sh.
# NAO mexer em font-size sem recalcular: o NotoColorEmoji tem caixa win de
# 1.171875em, muito maior que a do FindersKeepers (0.79em). O Pango usa a maior
# caixa da linha, entao num height=18 o limite e 18/1.171875 = 15.3px.
# 16px estoura (18.8px) e corta a parte de baixo do emoji e do rotulo.
font-size = 14
hint-font = false
horizontal = false
anchor = center
width = 700
height = 520
# border/outline 0 herdado do bloco canonico (tofi-apply.sh); padding espelhado
# do clipboard para a mesma caixa central.
padding-top = 14
padding-bottom = 14
padding-left = 18
padding-right = 18
min-input-width = 120
result-spacing = 12
prompt-text = ""
scale = true
exclusive-zone = -1
hide-cursor = true
text-cursor = true
num-results = 0
history = true
fuzzy-match = false
require-match = true
auto-accept-single = false
# tofi-colors-begin (gerado por tofi-apply.sh — nao editar este bloco)
# FONT por NOME de familia, nunca por caminho: com caminho absoluto o Pango nao
# monta a cadeia de fallback do fontconfig e todo emoji vira caixa vazia.
font = FindersKeepers
text-color = #ecedee
background-color = #0b0d0e
selection-color = #dbdbdc
selection-background = #595d5f
selection-match-color = #dadada
placeholder-color = #ecedeeA8
prompt-background = #00000000
input-background = #00000000
input-color = #ecedee
alternate-result-background = #00000000
default-result-background = #00000000
prompt-color = #ecedee
border-color = #595d5f
outline-width = 0
corner-radius = 0
border-width = 0
