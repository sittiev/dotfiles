# kanshi — perfis de hotplug (Wayland, protocolo wlr-output-management).
# Dono do hotplug AUTO; o override MANUAL continua em sway/scripts/outputs.sh
# (monitormenu.sh → outputs.sh hdmi|laptop|extend|mirror). O manual persiste
# até o próximo hotplug, quando o kanshi reaplica o perfil.
#
# Ordem importa: o perfil vale se TODOS os outputs listados estiverem
# conectados (físico, não enabled). eDP-1 interno está sempre conectado,
# então `docked` (HDMI+eDP) vem primeiro: com HDMI ele casa, sem HDMI cai
# no `laptop`. Extend/espelho não têm perfil auto (mesmo conjunto conectado
# do docked) — ficam só no outputs.sh manual.
# Posições espelham outputs.sh: HDMI à esquerda (0 0), eDP à direita (1920 0).
# `exec` não reaplica output (o kanshi já aplicou): só foca a saída.

profile docked {
	output HDMI-A-1 enable position 0,0
	output eDP-1 disable
	exec ~/.config/sway/scripts/kanshi-hook.sh hdmi
}

profile laptop {
	output eDP-1 enable position 0,0
	exec ~/.config/sway/scripts/kanshi-hook.sh laptop
}
