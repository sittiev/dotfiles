<menu id="monitors-menu" label="Monitores">
  <item label="HDMI principal (estender)">
    <action name="Execute"><command>sh -c 'xrandr --output HDMI-A-0 --primary --mode 1920x1080 --pos 0x0 --output eDP --mode 1920x1080 --pos 1920x0'</command></action>
  </item>
  <item label="Apenas HDMI">
    <action name="Execute"><command>sh -c 'xrandr --output HDMI-A-0 --primary --mode 1920x1080 --pos 0x0 --output eDP --off'</command></action>
  </item>
  <item label="Apenas notebook">
    <action name="Execute"><command>sh -c 'xrandr --output eDP --primary --mode 1920x1080 --pos 0x0 --output HDMI-A-0 --off'</command></action>
  </item>
  <item label="Espelhar">
    <action name="Execute"><command>sh -c 'xrandr --output HDMI-A-0 --primary --mode 1920x1080 --pos 0x0 --output eDP --mode 1920x1080 --pos 0x0'</command></action>
  </item>
</menu>

<menu id="system-menu" label="Sistema">
  <item label="Configurar Openbox (ObConf)">
    <action name="Execute">
      <command>obconf-qt</command>
      <startupnotify><enabled>yes</enabled></startupnotify>
    </action>
  </item>
  <item label="Reconfigurar Openbox">
    <action name="Reconfigure" />
  </item>
</menu>

<menu id="root-menu" label="Openbox 3">
  <item label="Terminal (st)">
    <action name="Execute"><command>st</command></action>
  </item>
  <item label="Executar (dmenu)">
    <action name="Execute"><command>dmenu_run</command></action>
  </item>
  <separator label="Aplicativos" />
  <menu id="apps-net-menu"/>
  <menu id="apps-files-menu"/>
  <menu id="apps-games-menu"/>
  <menu id="apps-media-menu"/>
  <menu id="apps-term-menu"/>
  <menu id="apps-tools-menu"/>
  <separator label="Sistema" />
  <menu id="monitors-menu"/>
  <menu id="system-menu"/>
  <separator />
  <item label="Sair">
    <action name="Exit"><prompt>yes</prompt></action>
  </item>
</menu>

</openbox_menu>
