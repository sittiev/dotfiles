<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="apps-term-menu" label="Terminal">
  <item label="st">
    <action name="Execute"><command>st</command></action>
  </item>
  <item label="Monitor do sistema (btop)">
    <action name="Execute"><command>st -e btop</command></action>
  </item>
  <item label="Editor (micro)">
    <action name="Execute"><command>st -e micro</command></action>
  </item>
</menu>

