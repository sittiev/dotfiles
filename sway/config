# Default config for sway
#
# This configuration preserves the current CachyOS workspace and output
# management. It replaces only the previous bar and launcher integration.
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $menu ~/.config/sway/scripts/tofi-safe.sh --drun --drun-launch=true

# Collapse Sway's native titlebar without changing workspace layout.
font pango:monospace 0.001

### Output configuration
#
# HDMI-A-1 e o principal, a esquerda (pos 0 0). eDP-1 (notebook) estende a
# direita quando ativo; com HDMI conectado o kanshi (perfil docked) desliga o
# eDP — fallback outputs.sh auto quando sem kanshi. Posicoes aqui sao o
# fallback estatico antes do daemon aplicar o perfil.
output HDMI-A-1 pos 0 0
output eDP-1 pos 1920 0
workspace 1 output HDMI-A-1 eDP-1
output * bg #dbe2e8 solid_color
# Waypaper is the only owner of swaybg; disable Sway's fallback helper.
swaybg_command -

### Input configuration
#
# Keep the current CachyOS input behavior.
input type:keyboard {
    xkb_layout "br"
    xkb_variant "abnt2"
}
input type:pointer {
    accel_profile flat
}

### Key bindings
#
# Basics:
    # Start a terminal
    bindsym $mod+Return exec $term
    bindsym $mod+t exec $term

    # Kill focused window
    bindsym $mod+q kill
    bindsym $mod+Shift+q kill

    # Start the launcher
    bindsym $mod+d exec $menu

    # Tofi tools restored from the Sway backup.
    bindsym $mod+o exec ~/.config/sway/scripts/tofi-themes.sh
    bindsym $mod+period exec ~/.config/sway/scripts/emoji.sh
    bindsym $mod+Shift+v exec ~/.config/sway/scripts/clipboard.sh
    bindsym $mod+Shift+x exec ~/.config/sway/scripts/menu.sh
    bindsym $mod+Shift+f exec ~/.config/sway/scripts/fsearch.sh
    bindsym $mod+Shift+Escape exec ~/.config/sway/scripts/dewlock.sh
    bindsym $mod+x exec ~/.config/sway/scripts/yambar-toggle.sh
    bindsym $mod+n exec ~/.config/sway/scripts/nightlight.sh
    bindsym $mod+Shift+n exec ~/.config/sway/scripts/nightmenu.sh
    bindsym $mod+g exec ~/.config/sway/scripts/game-mode.sh toggle

    # Drag floating windows by holding down $mod and left mouse button.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway
    bindsym $mod+Shift+e exec swaynag -t warning -m 'Sair do Sway? A sessão será encerrada.' -B 'Sair' 'swaymsg exit'

# Moving around:
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

# Workspaces: kept identical to the current CachyOS Sway configuration.
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

# Layout:
    bindsym $mod+b splith
    bindsym $mod+v splitv
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e exec ~/.config/sway/scripts/file-manager.sh open
    bindsym $mod+Shift+s layout toggle split
    bindsym $mod+f fullscreen
    bindsym $mod+space floating toggle
    bindsym $mod+Shift+space focus mode_toggle
    bindsym $mod+a focus parent

# Scratchpad:
    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

# Resize:
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Utilities:
    # Audio uses PipeWire plus the Mako OSD from the rice backup.
    bindsym --locked XF86AudioMute exec ~/.config/sway/scripts/volume.sh toggle
    bindsym --locked XF86AudioLowerVolume exec ~/.config/sway/scripts/volume.sh down
    bindsym --locked XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume.sh up
    bindsym --locked XF86AudioMicMute exec ~/.config/sway/scripts/volume.sh mic_toggle

    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    bindsym --locked XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness.sh down
    bindsym --locked XF86MonBrightnessUp exec ~/.config/sway/scripts/brightness.sh up

    # Screenshots go directly to the Wayland clipboard.
    bindsym Print exec dash -c 'grim - | wl-copy'
    bindsym Shift+Print exec dash -c 'grim -g "$(slurp)" - | wl-copy'

include /etc/sway/config.d/*

# --- Rice visual layer -------------------------------------------------
# Workspace and monitor management above is intentionally unchanged.
focus_follows_mouse yes
mouse_warping output
# hide_cursor when-typing fica FORA: o sway esconder o cursor enquanto se
# "digita" (z/x no osu! contam) fazia o jogo re-confinar o ponteiro e o
# cursor teleportava para o canto da tela. O jogo cuida do cursor dele.

# Gaps: 50 dentro, 0 fora. O yambar nao tem margins (render.sh nao emite
# nenhuma), entao todo espacamento vem daqui.
gaps inner 50
gaps outer 0
# --i3 hides single-child tab/stack bars.
titlebar_border_thickness 0
titlebar_padding 0
# default_border so vale para containers NOVOS: janela ja aberta guarda a
# largura antiga (por isso o pcmanfm ficava com 1px). for_window [all] cobre
# as que ja existem e as que vierem depois, entao as duas linhas sao necessarias.
default_border pixel 2
default_floating_border pixel 2
for_window [all] border pixel 2
hide_edge_borders --i3 none
smart_borders off

# Sem borda visivel em janela inativa: border/indicator/child_border das
# classes nao-focadas sao transparentes (render.sh regenera estas linhas;
# nao volte para a cor de fundo — em wallpaper claro ela vira borda branca).
client.focused   #B8B59D #767466 #FAFAFA #B8B59D #767466
client.unfocused #00000000 #141414 #71706A #00000000 #00000000
client.focused_inactive #00000000 #141414 #71706A #00000000 #00000000
client.placeholder      #00000000 #141414 #71706A #00000000 #00000000
client.background       #141414
client.urgent           #B8B59D #666458 #E1E0DF #B8B59D #666458

for_window [window_type="dialog"] floating enable, move position center
for_window [window_type="utility"] floating enable, move position center
for_window [app_id="pavucontrol"] floating enable, move position center
for_window [app_id="blueman-manager"] floating enable, move position center
for_window [app_id="overskride"] floating enable, move position center
for_window [app_id="iwgtk"] floating enable, move position center
for_window [app_id="yambar-tasks"] floating enable, move position center
for_window [app_id="yambar-dirs"] floating enable, move position center
for_window [app_id="menu"] floating enable, move position center

# Gerenciadores de arquivo sempre em float: pcmanfm, dolphin e os comuns
# (thunar, nemo, nautilus, pcmanfm-qt, spacefm, doublecmd, krusader, qtfm,
# xfe). Aqui o dolphin registra app_id "org.kde.dolphin" (confira com
#   swaymsg -t get_tree | grep -o '"app_id": "[^"]*"')
# por isso as duas variantes. (?i) ignora maiuscula/minuscula, ^...$ exige
# app_id exato (nao casa substring). FMs de terminal (ranger/lf/yazi/nnn)
# rodam dentro do terminal, nao tem app_id proprio. O resize set e opcional:
# comente a parte se preferir o tamanho natural da janela.
for_window [app_id="(?i)^(pcmanfm|pcmanfm-qt|dolphin|org\.kde\.dolphin|thunar|nemo|nautilus|org\.gnome\.nautilus|spacefm|doublecmd|krusader|qtfm|xfe)$"] floating enable, move position center, resize set 1024 640

# Native lightweight Wayland clients; wallpaper and theme are refreshed by Waypaper.
exec ~/.config/sway/scripts/theme.sh
exec dash -c 'command -v waypaper >/dev/null 2>&1 && command -v swaybg >/dev/null 2>&1 && ~/.config/sway/scripts/wallpaper.sh --restore >/dev/null 2>&1'
exec_always dash -c 'pgrep -x yambar >/dev/null 2>&1 || LC_TIME=C yambar >/dev/null 2>&1'
exec_always dash -c 'pgrep -x mako >/dev/null 2>&1 || mako >/dev/null 2>&1'
exec_always ~/.config/sway/scripts/cliphist-watch.sh
# Hotplug via kanshi (perfis em ~/.config/kanshi/config; exec chama
# kanshi-hook.sh p/ focar a saida). Sem kanshi, fallback outputs.sh auto.
# pkill antes: mesmo padrão do autotiling-rs abaixo — exec_always acumularia
# um daemon a cada `swaymsg reload`. O manual (monitormenu.sh → outputs.sh)
# persiste até o próximo hotplug, quando o kanshi reaplica o perfil.
exec_always dash -c 'if command -v kanshi >/dev/null 2>&1 && [ -f "$HOME/.config/kanshi/config" ]; then pkill -x kanshi >/dev/null 2>&1 || true; sleep 0.2; kanshi >/dev/null 2>&1 & else ~/.config/sway/scripts/outputs.sh auto >/dev/null 2>&1; fi'
bindswitch --reload --locked lid:on exec ~/.config/sway/scripts/outputs.sh lid on
bindswitch --reload --locked lid:off exec ~/.config/sway/scripts/outputs.sh lid off
exec_always ~/.config/sway/scripts/idle.sh
exec_always ~/.config/sway/scripts/battery.sh
# Buildo depois do compositor: stderr no /dev/null; antes do Wayland estar
# pronto o Qt despeja "connection broke"/"wl_display" no TTY do ly e cobre a
# tela por alguns segundos. O agente ignora a saída mesmo com sucesso.
exec /usr/bin/lxqt-policykit-agent >/dev/null 2>&1
exec swaymsg focus output HDMI-A-1 >/dev/null 2>&1

# Alterna splith/splitv conforme a proporcao da janela em foco (autotiling-rs).
# pkill antes de iniciar: o README upstream manda usar exec_always e acumularia um
# processo a cada `swaymsg reload` (nwg-piotr/autotiling issue #69). Assim
# recarrega o binario sem duplicar. Saida descartada porque o programa escreve
# em stderr toda vez que nao ha janela focada, o que poluiria o log do sway.
# O menu Janelas desliga via ~/.cache/autotiling-off: com o arquivo presente
# o reload nao ressuscita o processo (volta só pelo menu ou game-mode off).
exec_always dash -c 'pkill -x autotiling-rs >/dev/null 2>&1; sleep 0.2; [ -f "${XDG_CACHE_HOME:-$HOME/.cache}/autotiling-off" ] || autotiling-rs >/dev/null 2>&1'

# swaytiles: layouts por workspace (master, dwindle, grid, tabs...). O daemon
# roda como servico systemd --user (nao precisa de exec aqui). Enquanto um
# workspace esta no layout "default" o swaytiles nao toca na arvore, entao ele
# convive com o autotiling-rs acima; ao escolher um layout num workspace,
# desligue o autotiling-rs (menu Janelas, arquivo ~/.cache/autotiling-off)
# para os dois nao brigarem pelo controle das janelas.
bindsym $mod+Shift+t exec /home/rafael/.local/bin/swaytiles menu --launcher tofi
bindsym $mod+m exec /home/rafael/.local/bin/swaytiles swap

# Alt-Tab estilo Windows (sway-alttab-gui, Rust/GTK): daemon orientado a
# evento, inscrito no IPC do sway — sem polling, custo ~0% CPU com jogo
# rodando. O bind nao abre processo GTK: so manda um SIGUSR1 ao daemon via
# pidfile; a janela fica pre-realizada escondida e so aparece no switch.
# --mode all: lista janelas de todas as workspaces; focar uma delas faz o
# sway trocar pra workspace da janela automaticamente.
# pkill antes de iniciar, mesmo padrao do kanshi/autotiling-rs acima: sem
# isso o rm orfana o daemon vivo (pidfile some, show falha silencioso).
# stderr descartado para nao poluir o log do sway.
# pidfile stale derruba o show em erro silencioso (ESRCH): remove apos o
# pkill para o reload ressuscitar mesmo apos kill externo.
exec_always dash -c 'pkill -x sway-alttab-gui >/dev/null 2>&1 || true; sleep 0.2; rm -f ${XDG_RUNTIME_DIR:-/run/user/$UID}/sway-alttab-gui.pid; sway-alttab-gui daemon --mode all >/dev/null 2>&1'
bindsym Mod1+Tab exec sway-alttab-gui show

# Cursor theme and size are intentionally not configured here.
