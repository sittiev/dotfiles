# Overrides de envelopes — Apprentice, orientação LIGHT (scheme_init light).
# Espelha a documentação do colorlib: BG L88-94, FG L22-30, ACCENT S15-28
# L45-55, MUTED S0-12 L60-74. BRI não era documentado: espelho do dark.
# (Hoje o código *_light do colorlib é dead code — este arquivo religa a
# intenção documentada quando o modo claro estiver ativo.)
ENV_BG_S_MIN=0
ENV_BG_S_MAX=8
ENV_BG_L_MIN=88
ENV_BG_L_MAX=94
ENV_FG_S_MIN=0
ENV_FG_S_MAX=8
ENV_FG_L_MIN=22
ENV_FG_L_MAX=30
ENV_ACC_S_MIN=15
ENV_ACC_S_MAX=28
ENV_ACC_L_MIN=45
ENV_ACC_L_MAX=55
ENV_MUT_S_MIN=0
ENV_MUT_S_MAX=12
ENV_MUT_L_MIN=60
ENV_MUT_L_MAX=74
ENV_BRI_S_MIN=20
ENV_BRI_S_MAX=40
ENV_BRI_L_MIN=30
ENV_BRI_L_MAX=45
