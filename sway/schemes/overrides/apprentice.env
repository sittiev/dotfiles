# Overrides de envelopes — Apprentice (Gogh: variant dark, #262626/#BCBCBC).
# Orientação DARK. Reproduz as constantes históricas do colorlib.sh para que
# "escolher Apprentice" seja byte-idêntico ao sistema antigo (regressão T3).
# Gerido por sway/scripts/schemelib.sh (scheme_init dark).
ENV_BG_S_MIN=0
ENV_BG_S_MAX=8
ENV_BG_L_MIN=12
ENV_BG_L_MAX=18
ENV_FG_S_MIN=0
ENV_FG_S_MAX=8
ENV_FG_L_MIN=68
ENV_FG_L_MAX=76
ENV_ACC_S_MIN=20
ENV_ACC_S_MAX=35
ENV_ACC_L_MIN=45
ENV_ACC_L_MAX=55
ENV_MUT_S_MIN=0
ENV_MUT_S_MAX=12
ENV_MUT_L_MIN=26
ENV_MUT_L_MAX=40
ENV_BRI_S_MIN=20
ENV_BRI_S_MAX=40
ENV_BRI_L_MIN=55
ENV_BRI_L_MAX=70
